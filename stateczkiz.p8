pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

--init dziala raz na poczatku
function _init()

	cls()
	mode="start"
	blinkt = 0
	
	stars={}	
		for i = 1,100 do
			local newstar={}
			newstar.x=flr(rnd(128))
			newstar.y=flr(rnd(128))
			newstar.spd=rnd(2)+0.5
			add(stars,newstar)
		end
	
	ship = {}
	

	
	buls={}
		
end

--update jest dla rozgrywki
function _update()
	blinkt+=1
	
	if mode=="game" then 
		update_game()
	elseif mode=="start" then 
		update_start()
	elseif mode=="over" then
		update_over()
	elseif mode=="ready" then
		update_ready()	
	end

end

function _draw()

	if mode=="game" then 
		draw_game()
	elseif mode=="start" then 
		draw_start()
	elseif mode=="over" then
		draw_over()
	elseif mode=="ready" then
		draw_ready()	
	end
	
end


function startgame()
	mode = "game"
	
	ship = {}
	
	ship.x = 64
	ship.y = 94
	ship.sx = 0
	ship.sy = 0
	ship.spr = 1
	
	bulletspr = 16
	flamespr = 32

	bulletx = 64
	bullety = 40
	
	muzzle = 0
	
	score = 10000
	

	enemies = {}
	local myen={}
	myen.x=60
	myen.y=0
	myen.spr=112
	
	add(enemies,myen)
end
-->8
-- tools

function starfield()


	
	for i=1,#stars do 
		local mystar=stars[i]
		local scol=6
		
		if mystar.spd<1 then
			scol=1
		elseif mystar.spd<1.5 then
			scol=13
		end
		
		if mystar.spd>2.1 then
			line(mystar.x,mystar.y,mystar.x,mystar.y+3,scol)
		end
		
	pset(mystar.x,mystar.y,scol)
	end
	
end


function animatestars()
	
	for i=1,#stars do
		local mystar=stars[i]
		mystar.y=mystar.y+mystar.spd
		if mystar.y>128 then
			mystar.y=mystar.y-128
		end
	end
	
end

function eplanes_over()
	for i = 1,#eplanex do
		spr(5,eplanex[i],eplaney[i])
	end
end

function animateplanes_over()

	for i = 1,#eplaney do
		local epy=eplaney[i]
		epy=epy+eplanespd[i]
		if epy>128 then 
			epy=epy-128
		end
		eplaney[i]=epy
	end
end

function build_over()

	for i = 1,#buildx do
		spr(68,buildx[i],buildy[i])
	end
	
	
end


function blink()
	local banim={7,7,8,8,10,10,8,8,7,7}
	if blinkt>#banim then
		blinkt=1
	end
	
	return banim[blinkt]
end

function drwmyspr(myspr)
	spr(myspr.spr,myspr.x,myspr.y)
end
-->8
--update

function update_game()

 --poruszanie 
	ship.x+=ship.sx
	ship.y+=ship.sy

	--poruszanie pociskow
	for i=#buls,1,-1 do
		local mybul=buls[i]
		mybul.y=mybul.y-4
		
		if mybul.y<-8 then
			del(buls,mybul)
		end
	end	
	--poruszanie wrogow
	for myen in all(enemies) do
		myen.y+=1	 
	 myen.spr+=0.2
	 if myen.spr>=116 then
	 	myen.spr=112
	 end
	 
	 if myen.y>128 then
	 	del(enemies,myen)
	 end
	end
	
	--animacja ognia z wydechu
	flamespr = flamespr+1
	if flamespr > 36 then
		flamespr = 32
	end
	
	--animacja blysku z lufy
	if muzzle > 0 then
		muzzle=muzzle-1
	end
	
--kontrola krawedzi ekranu
	if ship.x>125 then
		ship.x = -5
	end
	
	if ship.x< -5 then
		ship.x = 125
	end
	
	if ship.y < 0 then
		ship.y = 0
	end
	
	if ship.y > 120 then
	 ship.y = 120
	end
	
--reset predkosci podczas kazdej
--klatki
	ship.sx = 0
	ship.sy = 0
	ship.spr = 1
--przyciski



	if btn(0) then
	 ship.sx = -2
	 ship.spr=2
	end
	
	if btn(1) then 
		ship.sx = 2
		ship.spr=3
	end

	
	if btn(2) then
	 ship.sy = -2
	end
	
	if btn(3) then 
		ship.sy = 2
	end
	
	if btnp(4) then
		local newbul={}
		newbul.x=ship.x
		newbul.y=ship.y-3
		newbul.spr=16
		add(buls,newbul)
				
		sfx(0)
		muzzle = 2
	end
	
	if btnp(5) then
		mode = "over"
		init_over()
	end
	
	animatestars()
end

function update_start()
animatestars()
	if btnp(4) or btnp(5) then
		mode = "ready"
		readyt = 60
		ship.x = 64
		ship.y = 94
		ship.spr = 1
		flamespr = 32
		sfx(0)
	end
end

function update_ready()
	animatestars()
	readyt -= 1
	
	if readyt<=0 then
		startgame()
	end
end

function init_over()
	eplanex = {}
	eplaney = {}
	eplanespd = {}
	
	for i = 1,20 do
		add(eplanex, flr(rnd(128)))
		add(eplaney, flr(rnd(128)))
		add(eplanespd,rnd(2)+0.5)
	end
	
	buildx = {}
	buildy = {}
	
	for i = 1,15 do
		add(buildx, flr(rnd(128)))
		add(buildy, flr(rnd(128)))
	end
	
end

function update_over()

	animateplanes_over()
	
	if btnp(4) or btnp(5) then
		mode = "start"
	end
end
-->8
--draw

	--draw dziala kiedy powstaje
	--nowa klatka
function draw_game()
	
	cls()
	starfield()
	drwmyspr(ship)
	spr(flamespr,ship.x,ship.y+8)
	
	--rysuje wrogow
	for myen in all(enemies) do
		drwmyspr(myen)
	end
	
	--rysuje pociski
	for mybul in all(buls) do
		spr(bulletspr,mybul.x,mybul.y)
	end

	
	if  muzzle>0 then
		circfill(ship.x+1,ship.y,muzzle,7)
		circfill(ship.x+6,ship.y,muzzle,7)
	end
		
	print("wynik:"..score, 45,1,12)
	
	lives = 3
	for i = 1,4 do
	
		if lives>=i then
			spr(48,i*9-8,1)
		else
			spr(49,i*9-8,1)
		end
	
	end
	bombs = 1
	for i = 1,3 do
	
		if bombs>=i then
			spr(50,127-i*9,1)
		else
			spr(51,127-i*9,1)
		end
	end
end

function draw_start()
	cls(1)
	rectfill(5,5,122,36,0)
	clip(5,5,117,31)
	starfield()
	clip()
	spr (11,47,5, 4,4)
	print("samoloto-strzelajka", 30,40,7) 
	print("nr 1 w polsce", 40, 60, 8)
	print("wcisinij dowolny przycisk", 15, 80,blink())
	print("dowolny czyli x albo z", 20, 100,blink())


end	

function draw_over()
	cls(3)
	build_over()
	eplanes_over()
	spr(57, 60, 15)
 spr(70,0,0,4,4)
 rectfill(32,0,128,31,12)
 rect(0,0,128,31,4)
	print("i zstapil duch nasz i",35,4,0)
	print("odnowil oblicze ziemi",35,10,0)
	print("-tej ziemi",35,16,0)
	print("papiez zdobyl polske", 25,40,0) 
	print("sprobowac ponownie?", 25, 60,10)
	print("wcisinij dowolny przycisk", 15, 80,blink())
	print("dowolny znaczy x albo z", 20, 100,blink())
end
	
function draw_ready()
	cls()
	starfield()
	
	--postep od 0 (dopiero wciわいniろ▥to start) do 1 (koniec)
	local progress = (60-readyt)/60
	
	--statek "wjeわもdわもa" od doわ🐱u ekranu
	--na docelowろ✽ pozycjろ▥ (tろ▥ samろ✽ co w grze)
	local starty = 140
	local sy = starty + (ship.y-starty)*progress
	spr(ship.spr, ship.x, sy)
	spr(flamespr, ship.x, sy+8)
	
	--pasek わ🐱adowania
	local barx,bary,barw,barh = 24,70,80,7
	rect(barx,bary,barx+barw,bary+barh,7)
	rectfill(barx+1,bary+1,barx+1+(barw-2)*progress,bary+barh-1,11)
	
	print("przygotuj sie do walki!", 15, 55, blink())
end
